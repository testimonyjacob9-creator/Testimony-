# Copy to .env and fill in. NEVER commit .env.
# ===== The only two values you normally need =====
OWNER_PHONE=
GEMINI_API_KEY=
# Everything below is OPTIONAL: each has a safe default. Leave it out unless you have a reason.

# --- Owner ---
# OWNER_PHONE (above): your personal number, international format, digits only (e.g. 2347065702702)

# --- Provider ---
# mock (development/tests, sends nothing) | baileys (unofficial WhatsApp Web)
WHATSAPP_PROVIDER=mock

# Required when WHATSAPP_PROVIDER=baileys. Read docs/ACCOUNT_SETUP.md first.
#   self     = the assistant runs ON your own WhatsApp account (you message yourself)
#   separate = the assistant runs on its own dedicated number (you message that number)
ACCOUNT_MODE=
# Number of the account being linked. Only needed for ACCOUNT_MODE=separate.
BOT_PHONE=
# Optional. Only if WhatsApp hides your phone number behind an ID (123456789@lid).
OWNER_LID=

# --- General ---
TIMEZONE=Africa/Lagos
LOG_LEVEL=info
DATA_DIR=./data
MAX_MEDIA_MB=50
# Wait this long after the last upload before sending one summary message
MEDIA_ACK_DELAY_MS=3000
# Minutes an unconfirmed draft stays valid
PROPOSAL_TTL_MINUTES=30

# --- AI (Gemini). GEMINI_API_KEY (above) goes ONLY in .env (git-ignored) or Render's dashboard ---
# Enabled by default when GEMINI_API_KEY is set. Without a key OLIVES starts normally and reports AI as unavailable.
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Safety budget: maximum model calls per UTC day, and per-call timeout
AI_DAILY_REQUEST_LIMIT=300
AI_TIMEOUT_MS=20000

# --- Group marketing safety limits ---
# Seconds between sends to different groups
GROUP_SEND_DELAY_SECONDS=30
# Maximum groups in one advert
MAX_GROUPS_PER_CAMPAIGN=10
# Do not repeat the same advert to a group within this many hours
GROUP_DEDUPE_HOURS=24

# --- Scheduling ---
# Attempts per scheduled Status run (1 = no retry) and the wait between attempts
SCHEDULE_MAX_ATTEMPTS=2
SCHEDULE_RETRY_DELAY_SECONDS=120
# A run later than this after its time is skipped and reported, never posted late
MISSED_RUN_GRACE_MINUTES=120

# --- Optional dashboard (Phase 8, off by default) ---
DASHBOARD_ENABLED=false
DASHBOARD_TOKEN=

# --- Hosting (Render sets PORT itself; you normally never touch these) ---
# PORT=10000            # when set, GET /health answers 200 on 0.0.0.0:PORT
# EPHEMERAL_OK=true     # acknowledge that DATA_DIR is temporary (free hosting)
