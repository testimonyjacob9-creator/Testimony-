# Copy to .env and fill in. NEVER commit .env.
# --- Owner (required) ---
# Your personal number, international format, digits only (e.g. 2348012345678)
OWNER_PHONE=

# --- Provider ---
# mock (development/tests, sends nothing) | baileys (unofficial WhatsApp Web)
WHATSAPP_PROVIDER=mock

# Required when WHATSAPP_PROVIDER=baileys. Read docs/ACCOUNT_SETUP.md first.
#   self     = the assistant runs ON your own WhatsApp account (you message yourself)
#   separate = the assistant runs on its own dedicated number (you message that number)
ACCOUNT_MODE=
# Number of the account being linked. Only needed for ACCOUNT_MODE=separate.
BOT_PHONE=
# Optional. Only if WhatsApp hides your phone number behind an ID (123456789@lid).
OWNER_LID=

# --- General ---
TIMEZONE=Africa/Lagos
LOG_LEVEL=info
DATA_DIR=./data
MAX_MEDIA_MB=50
# Minutes an unconfirmed draft stays valid
PROPOSAL_TTL_MINUTES=30

# --- Optional dashboard (Phase 8, off by default) ---
DASHBOARD_ENABLED=false
DASHBOARD_TOKEN=
