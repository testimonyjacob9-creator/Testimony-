# Copy to .env and fill in. NEVER commit .env.
# --- Owner (required) ---
# Your personal number in international format, digits only (e.g. 2348012345678)
OWNER_PHONE=

# --- Provider ---
# mock (development/tests, sends nothing) | baileys (unofficial WhatsApp Web, Phase 2)
WHATSAPP_PROVIDER=mock

# --- General ---
TIMEZONE=Africa/Lagos
LOG_LEVEL=info
DATA_DIR=./data
MAX_MEDIA_MB=50

# --- Optional dashboard (Phase 8, off by default) ---
DASHBOARD_ENABLED=false
DASHBOARD_TOKEN=
